generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum TransactionDirection {
  INCOME
  EXPENSE
}

enum ClientStatus {
  ACTIVE
  STANDBY
  DELINQUENT
  CANCELED
  PROSPECT
}

enum ServiceType {
  OTHER
}

enum ReceivableStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELED
  RENEGOTIATED
}

enum PayableStatus {
  OPEN
  PAID
  OVERDUE
  INSTALMENT
  RENEGOTIATED
  SUSPENDED
}

enum PayableType {
  FIXED
  VARIABLE
  RECURRING
  EXTRAORDINARY
  DEBT
  INVESTMENT
}

enum RecurrenceType {
  ONE_TIME
}

model Workspace {
  id               String            @id
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  accounts         Account[]
  categories       Category[]
  costCenters      CostCenter[]
  clients          Client[]
  contracts        Contract[]
  transactions     Transaction[]
  receivables      Receivable[]
  payables         Payable[]
  providers        Provider[]
  workspaceOptions WorkspaceOption[]
  debts            Debt[]
  documents        Document[]
}

model WorkspaceOption {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  kind        String
  value       String
  label       String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([workspaceId, kind, value])
  @@index([workspaceId, kind])
}

model User {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("OWNER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Account {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  name        String
  type        String
  institution String
  balance     Decimal    @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  transactions Transaction[]
  receivables Receivable[]
  payables    Payable[]
}

model Category {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  name        String
  slug        String
  isIncome    Boolean      @default(false)
  color       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  transactions Transaction[]
  payables    Payable[]
  @@unique([workspaceId, slug])
}

model CostCenter {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  transactions Transaction[]
  payables    Payable[]
  @@unique([workspaceId, name])
}

model Client {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id])
  name           String
  status         ClientStatus @default(ACTIVE)
  monthlyContract Decimal     @default(0)
  startDate      DateTime?
  services       ServiceType[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  contracts      Contract[]
  receivables    Receivable[]
  transactions   Transaction[]
}

model Contract {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id])
  title       String
  monthlyValue Decimal
  startsAt    DateTime
  dueDay      Int
  services    ServiceType[]
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  receivables Receivable[]
}

model Transaction {
  id            String               @id @default(cuid())
  workspaceId   String
  workspace     Workspace            @relation(fields: [workspaceId], references: [id])
  transactionAt DateTime
  competency    DateTime
  direction     TransactionDirection
  description   String
  amount        Decimal
  accountType   String
  institution   String
  accountId     String?
  account       Account?             @relation(fields: [accountId], references: [id])
  categoryId    String?
  category      Category?            @relation(fields: [categoryId], references: [id])
  costCenterId  String?
  costCenter    CostCenter?          @relation(fields: [costCenterId], references: [id])
  clientId      String?
  client        Client?              @relation(fields: [clientId], references: [id])
  duplicateHash String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
}

model Receivable {
  id            String           @id @default(cuid())
  workspaceId   String
  workspace     Workspace        @relation(fields: [workspaceId], references: [id])
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id])
  contractId    String?
  contract      Contract?        @relation(fields: [contractId], references: [id])
  competency    DateTime
  expectedAmount Decimal
  receivedAmount Decimal         @default(0)
  expectedDate  DateTime
  receivedDate  DateTime?
  status        ReceivableStatus @default(PENDING)
  accountId     String?
  account       Account?         @relation(fields: [accountId], references: [id])
  observations  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
}

model Provider {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  payables    Payable[]
  @@unique([workspaceId, name])
}

model Payable {
  id            String        @id @default(cuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  description   String
  providerId    String?
  provider      Provider?     @relation(fields: [providerId], references: [id])
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  costCenterId  String?
  costCenter    CostCenter?   @relation(fields: [costCenterId], references: [id])
  amount        Decimal
  dueDate       DateTime
  status        PayableStatus @default(OPEN)
  type          PayableType
  accountId     String?
  account       Account?      @relation(fields: [accountId], references: [id])
  recurrence    RecurrenceType @default(ONE_TIME)
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
}

model Debt {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  creditor          String
  type              String    @default("LOAN")
  originalAmount    Decimal
  outstandingAmount Decimal
  monthlyRate       Decimal?
  dueDate           DateTime?
  totalInstalments  Int?
  paidInstalments   Int       @default(0)
  status            String    @default("ON_TIME")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

model Document {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  type         String    @default("OTHER")
  url          String?
  clientId     String?
  amount       Decimal?
  documentDate DateTime?
  notes        String?
  tags         String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}
