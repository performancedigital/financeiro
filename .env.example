# ─────────────────────────────────────────────────────────────
# Banco de dados (PostgreSQL / Supabase)
# Na Vercel, a integração do Supabase preenche estas duas automaticamente.
# Localmente, copie da aba "Connection string" do seu projeto Supabase.
# ─────────────────────────────────────────────────────────────
# Pooler — usado pelo Prisma Client em runtime
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão direta — usada por migrations (prisma migrate deploy / db push)
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Sessão / Autenticação (OBRIGATÓRIO em produção)
# Gere uma chave forte: openssl rand -base64 32
# Sem isso, o build/runtime em produção falha de propósito (sessões não podem ser fracas).
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
