generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum AccountType {
  PERSONAL_HELBERT
  HOUSEHOLD
  PERSONAL_LEIDIANE
  BUSINESS_AGENCY
  TRAVEL_EXTRA
  DEBT
  REIMBURSEMENT
  WORKING_CAPITAL
}

enum FinancialInstitution {
  SICOOB
  NUBANK
  CAIXA
  BRADESCO
  MERCADO_PAGO
  INFINITEPAY
  COMPANY_ACCOUNT
  CASH
  OTHER
}

enum TransactionDirection {
  INCOME
  EXPENSE
}

enum ClientStatus {
  ACTIVE
  STANDBY
  DELINQUENT
  CANCELED
  PROSPECT
}

enum ServiceType {
  OTHER
}

enum ReceivableStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELED
  RENEGOTIATED
}

enum PayableStatus {
  OPEN
  PAID
  OVERDUE
  INSTALMENT
  RENEGOTIATED
  SUSPENDED
}

enum PayableType {
  FIXED
  VARIABLE
  RECURRING
  EXTRAORDINARY
  DEBT
  INVESTMENT
}

enum RecurrenceType {
  ONE_TIME
}

model Workspace {
  id          String        @id
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       User[]
  accounts    Account[]
  categories  Category[]
  costCenters CostCenter[]
  clients     Client[]
  contracts   Contract[]
  transactions Transaction[]
  receivables Receivable[]
  payables    Payable[]
  providers   Provider[]
}

model User {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("OWNER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Account {
  id          String               @id @default(cuid())
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id])
  name        String
  type        AccountType
  institution FinancialInstitution
  balance     Decimal              @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  transactions Transaction[]
  receivables Receivable[]
  payables    Payable[]
}

model Category {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  name        String
  slug        String
  isIncome    Boolean      @default(false)
  color       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  transactions Transaction[]
  payables    Payable[]
  @@unique([workspaceId, slug])
}

model CostCenter {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  transactions Transaction[]
  payables    Payable[]
  @@unique([workspaceId, name])
}

model Client {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id])
  name           String
  status         ClientStatus @default(ACTIVE)
  monthlyContract Decimal     @default(0)
  startDate      DateTime?
  services       ServiceType[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  contracts      Contract[]
  receivables    Receivable[]
  transactions   Transaction[]
}

model Contract {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id])
  title       String
  monthlyValue Decimal
  startsAt    DateTime
  dueDay      Int
  services    ServiceType[]
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  receivables Receivable[]
}

model Transaction {
  id            String               @id @default(cuid())
  workspaceId   String
  workspace     Workspace            @relation(fields: [workspaceId], references: [id])
  transactionAt DateTime
  competency    DateTime
  direction     TransactionDirection
  description   String
  amount        Decimal
  accountType   AccountType
  institution   FinancialInstitution
  accountId     String?
  account       Account?             @relation(fields: [accountId], references: [id])
  categoryId    String?
  category      Category?            @relation(fields: [categoryId], references: [id])
  costCenterId  String?
  costCenter    CostCenter?          @relation(fields: [costCenterId], references: [id])
  clientId      String?
  client        Client?              @relation(fields: [clientId], references: [id])
  duplicateHash String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
}

model Receivable {
  id            String           @id @default(cuid())
  workspaceId   String
  workspace     Workspace        @relation(fields: [workspaceId], references: [id])
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id])
  contractId    String?
  contract      Contract?        @relation(fields: [contractId], references: [id])
  competency    DateTime
  expectedAmount Decimal
  receivedAmount Decimal         @default(0)
  expectedDate  DateTime
  receivedDate  DateTime?
  status        ReceivableStatus @default(PENDING)
  accountId     String?
  account       Account?         @relation(fields: [accountId], references: [id])
  observations  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
}

model Provider {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  payables    Payable[]
  @@unique([workspaceId, name])
}

model Payable {
  id            String        @id @default(cuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  description   String
  providerId    String?
  provider      Provider?     @relation(fields: [providerId], references: [id])
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  costCenterId  String?
  costCenter    CostCenter?   @relation(fields: [costCenterId], references: [id])
  amount        Decimal
  dueDate       DateTime
  status        PayableStatus @default(OPEN)
  type          PayableType
  accountId     String?
  account       Account?      @relation(fields: [accountId], references: [id])
  recurrence    RecurrenceType @default(ONE_TIME)
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
}
